@model Idempiere_Plugin_Checker.Models.HomeViewModel
@{
    ViewData["Title"] = "Plugins por Ambiente";
}

<div class="container py-4">
    <!-- Header / Resumen superior -->
    <div class="text-center mb-4">
        <h1 class="display-6 fw-bold tracking-tight mb-2">Monitor de Plugins de iDempiere</h1>
        <p class="text-secondary mb-3">Consulta, filtra y analiza el estado de los plugins OSGi instalados en tus ambientes.</p>
        <div class="d-inline-flex align-items-center gap-3 bg-white px-3 py-1 rounded-pill border shadow-sm text-sm">
            <span class="text-secondary"><strong class="text-dark">@Model.TotalAmbientes</strong> Ambientes</span>
            <span class="text-muted">•</span>
            <span class="text-secondary"><strong class="text-primary" id="visiblePluginsCount">@Model.TotalPlugins</strong> Plugins visibles</span>
            <span class="text-muted">•</span>
            <span class="text-secondary"><strong class="text-success">@Model.TotalActivePlugins</strong> Activos</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SyncMessage))
    {
        <div class="alert @(Model.SyncSuccess == true ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi @(Model.SyncSuccess == true ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            @Model.SyncMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. Globitos de Filtrado por Ambiente (Indexados dinámicamente) -->
    <div class="filter-bubbles-container" id="environmentBubbles">
        <button type="button" class="filter-bubble @(Model.SelectedAmbienteId == null ? "active" : "")" data-amb-id="all">
            <i class="bi bi-grid-3x3-gap"></i>
            <span>Todos</span>
            <span class="bubble-badge">@Model.TotalPlugins</span>
        </button>

        @foreach (var amb in Model.Ambientes)
        {
            var isSelected = Model.SelectedAmbienteId == amb.IdAmb;
            var pluginCount = amb.Plugins?.Count ?? 0;
            <button type="button" class="filter-bubble @(isSelected ? "active" : "")" data-amb-id="@amb.IdAmb">
                <i class="bi bi-hdd-network"></i>
                <span>@amb.NamAmb</span>
                <span class="bubble-badge">@pluginCount</span>
            </button>
        }
    </div>

    <!-- 2. Barra de Búsqueda -->
    <div class="search-container">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="pluginSearchInput" class="search-input" placeholder="Barra de busqueda..." autocomplete="off" />
            <button type="button" id="searchClearBtn" class="search-clear-btn" title="Limpiar búsqueda">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- 3. Grid de Tarjetas con Efecto de Levitación -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="pluginCardsGrid">
        @foreach (var plugin in Model.Plugins)
        {
            var ambName = plugin.Ambiente?.NamAmb ?? $"Ambiente {plugin.IdAmb}";
            var author = plugin.ResolvedSubidoPor;
            var uploadDate = plugin.ResolvedUploadDate;
            
            <div class="col plugin-card-wrapper" 
                 data-amb-id="@plugin.IdAmb"
                 data-symbolic="@plugin.SymbolicName.ToLowerInvariant()"
                 data-name="@plugin.Name.ToLowerInvariant()"
                 data-state="@plugin.State.ToLowerInvariant()"
                 data-author="@author.ToLowerInvariant()"
                 data-version="@plugin.Version.ToLowerInvariant()"
                 data-ambname="@ambName.ToLowerInvariant()">
                
                <div class="plugin-levitate-card">
                    <!-- Cabecera de la tarjeta con nombre del plugin y separador -->
                    <div class="plugin-card-header">
                        <div class="plugin-title" title="@plugin.SymbolicName">@plugin.SymbolicName</div>
                        @if (!string.IsNullOrWhiteSpace(plugin.Name) && plugin.Name != plugin.SymbolicName)
                        {
                            <div class="plugin-friendly-name" title="@plugin.Name">@plugin.Name</div>
                        }
                    </div>

                    <!-- Cuerpo de la tarjeta en formato de 2 columnas según el wireframe -->
                    <div class="plugin-info-grid">
                        <!-- Fila 1: Estado y Ambiente -->
                        <div class="plugin-info-item">
                            <span class="info-label">Estado</span>
                            <div class="info-value">
                                <span class="badge-status @(plugin.IsActive ? "badge-status-active" : "badge-status-inactive")">
                                    <span class="status-dot"></span>
                                    <span>@plugin.State</span>
                                </span>
                            </div>
                        </div>

                        <div class="plugin-info-item">
                            <span class="info-label">Ambiente</span>
                            <div class="info-value">
                                <span class="badge-ambiente" title="@plugin.Ambiente?.DirAmb">
                                    <i class="bi bi-server"></i>
                                    <span>@ambName</span>
                                </span>
                            </div>
                        </div>

                        <!-- Fila 2: Subido Por y Versión -->
                        <div class="plugin-info-item">
                            <span class="info-label">Subido Por</span>
                            <div class="info-value">
                                <div class="badge-author">
                                    <span class="author-avatar">@author.Substring(0, Math.Min(author.Length, 2))</span>
                                    <span class="author-name">@author</span>
                                </div>
                                @if (!string.IsNullOrEmpty(uploadDate))
                                {
                                    <div class="upload-time" title="Fecha y hora de subida">
                                        <i class="bi bi-clock"></i> @uploadDate
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="plugin-info-item">
                            <span class="info-label">Versión</span>
                            <div class="info-value">
                                <span class="version-code" title="@plugin.Version">@plugin.Version</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Estado vacío cuando no hay coincidencias -->
    <div id="noResultsAlert" class="empty-state" style="display: none;">
        <i class="bi bi-search empty-state-icon"></i>
        <h4 class="fw-semibold">No se encontraron plugins</h4>
        <p class="text-secondary mb-3">No hay plugins que coincidan con el ambiente y término de búsqueda especificados.</p>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" id="resetFiltersBtn">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer filtros
        </button>
    </div>
</div>


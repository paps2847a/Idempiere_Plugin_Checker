@model Idempiere_Plugin_Checker.Models.KeyUserEditViewModel
@{
    ViewData["Title"] = "Editar Usuario de Solicitud";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="plugin-levitate-card p-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-1" style="width: 32px; height: 32px;" title="Volver">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="h5 fw-bold mb-0">Editar Credenciales OSGi</h2>
                        <small class="text-secondary">Modifica el usuario o contraseña de consulta para este ambiente</small>
                    </div>
                </div>

                <form asp-action="EditKeyUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdUsr" />
                    <input type="hidden" asp-for="IdAmb" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Ambiente Asociado</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-hdd-network"></i></span>
                            <input class="form-control bg-light" value="@Model.AmbienteNombre" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsrNam" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="UsrNam" class="form-control" autofocus />
                        </div>
                        <span asp-validation-for="UsrNam" class="text-danger small"></span>
                        <div class="form-text small">Usuario con acceso a la consola OSGi de este ambiente.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsrPass" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="UsrPass" class="form-control" placeholder="Dejar en blanco para mantener la actual" />
                        </div>
                        <span asp-validation-for="UsrPass" class="text-danger small"></span>
                        <div class="form-text small">Ingresa una nueva contraseña sólo si deseas cambiarla.</div>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsAct" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsAct" class="form-check-label small text-secondary">Credencial activa para sincronización</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check-lg"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model Idempiere_Plugin_Checker.Models.AdminUserFormViewModel
@{
    ViewData["Title"] = "Editar Administrador";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="plugin-levitate-card p-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-1" style="width: 32px; height: 32px;" title="Volver">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="h5 fw-bold mb-0">
                            Editar Administrador #@Model.IdUsr
                            @if (Model.IsSelf)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Tu Cuenta</span>
                            }
                        </h2>
                        <small class="text-secondary">Modifica el nombre de usuario, contraseña o estado</small>
                    </div>
                </div>

                @if (Model.IsSelf)
                {
                    <div class="alert alert-info py-2 px-3 rounded-3 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Estás modificando tus credenciales de sesión activa.
                    </div>
                }

                <form asp-action="EditAdminUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdUsr" />
                    <input type="hidden" asp-for="IsSelf" />

                    <div class="mb-3">
                        <label asp-for="UsrNam" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="UsrNam" class="form-control" autofocus />
                        </div>
                        <span asp-validation-for="UsrNam" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsrPass" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="UsrPass" class="form-control" placeholder="Dejar en blanco para conservar la actual" />
                        </div>
                        <span asp-validation-for="UsrPass" class="text-danger small"></span>
                        <div class="form-text small">Ingresa un valor sólo si deseas actualizar la contraseña.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPass" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="ConfirmPass" class="form-control" placeholder="Confirmar nueva contraseña" />
                        </div>
                        <span asp-validation-for="ConfirmPass" class="text-danger small"></span>
                    </div>

                    @if (Model.IsSelf)
                    {
                        <input type="hidden" asp-for="IsAct" value="true" />
                        <div class="mb-4 form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" checked disabled />
                            <label class="form-check-label small text-muted">Cuenta activa (no puedes desactivar tu propia cuenta)</label>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsAct" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsAct" class="form-check-label small text-secondary">Cuenta activa para inicio de sesión</label>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check-lg"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

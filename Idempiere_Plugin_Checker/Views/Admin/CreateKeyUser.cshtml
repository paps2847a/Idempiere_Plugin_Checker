@model Idempiere_Plugin_Checker.Models.KeyUserFormViewModel
@{
    ViewData["Title"] = "Asignar Usuario de Solicitud";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="plugin-levitate-card p-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle p-1" style="width: 32px; height: 32px;" title="Volver">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="h5 fw-bold mb-0">Asignar Usuario de Solicitud</h2>
                        <small class="text-secondary">Credenciales para consultar la consola OSGi de iDempiere</small>
                    </div>
                </div>

                <form asp-action="CreateKeyUser" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="IdAmb" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="IdAmb" class="form-select">
                            <option value="">-- Selecciona el Ambiente Destino --</option>
                            @foreach (var amb in Model.AmbientesDisponibles)
                            {
                                <option value="@amb.IdAmb">@amb.NamAmb (@amb.DirAmb)</option>
                            }
                        </select>
                        <span asp-validation-for="IdAmb" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsrNam" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="UsrNam" class="form-control" placeholder="ej. prierasystem" />
                        </div>
                        <span asp-validation-for="UsrNam" class="text-danger small"></span>
                        <div class="form-text small">Usuario con permisos de acceso a <code>/osgi/system/console/bundles.json</code>.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsrPass" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="UsrPass" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="UsrPass" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsAct" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsAct" class="form-check-label small text-secondary">Usuario activo para sincronización</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check-lg"></i> Guardar Credencial
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
